{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix preview-app install --include=dev",
  "buildCommand": "npm --prefix preview-app run build",
  "outputDirectory": "preview-app/dist/preview-app/browser",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
